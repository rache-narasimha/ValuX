# Copy to .env for local development. Never commit the completed file.
POSTGRES_DB=valsphere
POSTGRES_USER=valsphere
POSTGRES_PASSWORD=replace-with-a-long-random-password
MIGRATION_DATABASE_URL=postgresql://valsphere:replace-with-a-long-random-password@postgres:5432/valsphere
APP_DATABASE_USER=valsphere_app
APP_DATABASE_PASSWORD=replace-with-a-different-long-random-password
DATABASE_URL=postgresql://valsphere_app:replace-with-a-different-long-random-password@postgres:5432/valsphere

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AUTH_ENCRYPTION_KEY=replace-with-a-fernet-key
AUTH_RECOVERY_PEPPER=replace-with-another-long-random-value

APP_BASE_URL=http://192.168.1.3:4180
TENANT_TIME_ZONE=Asia/Kolkata
COOKIE_SECURE=false
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=12

# mailpit is for regression testing; smtp is for manual Gmail testing.
EMAIL_MODE=mailpit
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=false
EMAIL_FROM=ValuX <no-reply@valux.local>

# Optional deterministic local test accounts used only by the seed-dev CLI command.
VALUX_TEST_FATHER_ID=racheshiva01
VALUX_TEST_FATHER_NAME=K. Sivaprasad
VALUX_TEST_FATHER_PASSWORD=
VALUX_TEST_EMPLOYEE_ID=lavk0401
VALUX_TEST_EMPLOYEE_NAME=Lavakumar
VALUX_TEST_EMPLOYEE_PASSWORD=
